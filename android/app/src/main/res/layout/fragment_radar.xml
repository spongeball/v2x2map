<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0A0E13">

    <org.opentrafficmap.receiver.RadarView
        android:id="@+id/radarView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="14dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_pill"
        android:padding="2dp">

        <TextView android:id="@+id/radarRangeAuto"  style="@style/RateRangeTab" android:textColor="?attr/colorOnSurface" android:text="@string/radar_auto"/>
        <TextView android:id="@+id/radarRange250"   style="@style/RateRangeTab" android:textColor="?attr/colorOnSurface" android:text="250 m"/>
        <TextView android:id="@+id/radarRange500"   style="@style/RateRangeTab" android:textColor="?attr/colorOnSurface" android:text="500 m"/>
        <TextView android:id="@+id/radarRange1000"  style="@style/RateRangeTab" android:textColor="?attr/colorOnSurface" android:text="1 km"/>
    </LinearLayout>

    <TextView
        android:id="@+id/radarStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="14dp"
        android:textColor="#FFCFD8E2"
        android:textSize="12sp"
        tools:text="no contacts"/>

</FrameLayout>
