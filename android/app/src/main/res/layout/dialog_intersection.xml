<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/intersectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/intersection_title"
        android:textStyle="bold"
        android:textSize="17sp"/>

    <TextView
        android:id="@+id/intersectionPhase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="14sp"
        tools:text="GREEN · 12 s left"/>

    <TextView
        android:id="@+id/intersectionGeometry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:alpha="0.7"
        android:textSize="13sp"
        android:text="@string/intersection_no_geometry"/>

</LinearLayout>
